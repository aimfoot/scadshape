# systemd user service for the public scadshape web (behind the Cloudflare tunnel):
#   cp scadshape-public.service ~/.config/systemd/user/ && systemctl --user enable --now scadshape-public
# Listens only on 127.0.0.1:8791 (reachable from outside once the tunnel points here). Same dist/ as the development server.
[Unit]
Description=scadshape public web (for the Cloudflare tunnel) on 127.0.0.1:8791

[Service]
Environment=SCADSHAPE_PUBLIC=1 SCADSHAPE_HOST=127.0.0.1 SCADSHAPE_PORT=8791
ExecStart=/usr/bin/python3 -I %h/opt/scadshape/serve.py
Restart=always
RestartSec=5

# Hardening: of the home directory the process only sees serve.py and dist/ (read-only); nothing writable.
ProtectHome=tmpfs
BindReadOnlyPaths=%h/opt/scadshape/serve.py %h/opt/scadshape/dist
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=default.target
