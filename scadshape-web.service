# systemd user service for scadshape (development version), Tailscale only:
#   cp scadshape-web.service ~/.config/systemd/user/ && systemctl --user enable --now scadshape-web
# Listens on 127.0.0.1:8790. To reach it from the phone: a drop-in with the Tailscale IP, e.g.
#   ~/.config/systemd/user/scadshape-web.service.d/host.conf:  [Service]  Environment=SCADSHAPE_HOST=<ip>
# If it starts before Tailscale has its IP, it restarts until it works.
[Unit]
Description=scadshape web (development) on port 8790

[Service]
ExecStart=/usr/bin/python3 %h/opt/scadshape/serve.py
Restart=always
RestartSec=5

# Hardening: of the home directory the process only sees serve.py, dist/ (read-only) and data/ (benchmark results).
ProtectHome=tmpfs
BindReadOnlyPaths=%h/opt/scadshape/serve.py %h/opt/scadshape/dist
BindPaths=%h/opt/scadshape/data
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=default.target
